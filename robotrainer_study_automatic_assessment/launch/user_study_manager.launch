<?xml version="1.0"?>
<launch>

  <arg name="yaml_to_load" default="$(find robotrainer_study_automatic_assessment)/config/user_study_manager.yaml"/>

  <node name="robotrainer_user_study_manager" pkg="robotrainer_study_automatic_assessment" type="user_study_manager.py">
    <rosparam command="load" file="$(arg yaml_to_load)"/>
  </node>

</launch>
